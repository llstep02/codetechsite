{
	"name": "reactifyai-react-template",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"start": "vite --port 3000 --host",
		"build": "vite build --mode production && javascript-obfuscator dist --output dist",
		"preview": "vite preview --port 3000 --host",
		"pretty": "pretty-quick --pattern '**/*.*(js|jsx|ts|tsx)'",
		"lint": "eslint --ext .js --ext .jsx --ext .ts --ext .tsx ./src"
	},
	"dependencies": {
		"@emailjs/browser": "^4.4.1",
		"@headlessui/react": "^2.2.9",
		"@hookform/resolvers": "^5.2.2",
		"@tailwindcss/vite": "4.1.11",
		"aos": "^2.3.4",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "0.536.0",
		"react": "19.1.0",
		"react-dom": "19.1.0",
		"react-hook-form": "^7.62.0",
		"react-router-dom": "7.7.1",
		"react-toastify": "^11.0.5",
		"tailwind-merge": "^3.3.1",
		"vite-plugin-html": "3.2.2",
		"vite-tsconfig-paths": "5.1.4",
		"yup": "^1.7.0"
	},
	"devDependencies": {
		"@eslint/js": "9.30.1",
		"@types/aos": "^3.0.7",
		"@types/react": "19.1.8",
		"@types/react-dom": "19.1.6",
		"@types/react-toastify": "^4.1.0",
		"@vitejs/plugin-react": "4.6.0",
		"eslint": "9.30.1",
		"eslint-plugin-react-hooks": "5.2.0",
		"eslint-plugin-react-refresh": "0.4.20",
		"globals": "16.3.0",
		"javascript-obfuscator": "4.1.1",
		"tailwindcss": "4.1.11",
		"typescript": "5.8.3",
		"typescript-eslint": "8.35.1",
		"vite": "7.0.4"
	}
}